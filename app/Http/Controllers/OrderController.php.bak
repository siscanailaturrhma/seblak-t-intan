<?php

namespace App\Http\Controllers;

use App\Models\Menu;
use App\Models\Order;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\DB;

class OrderController extends Controller
{
    public function create(Menu $menu)
    {
        abort_unless($menu->is_available, 404);

        return view('order', [
            'usaha' => config('seblak.usaha'),
            'menu' => $menu,
            'groups' => $menu->resolvedOptionGroups(),
        ]);
    }

    public function store(Request $request)
    {
        $data = $request->validate([
            'menu_id' => ['required', 'exists:menus,id'],
            'customer_name' => ['required', 'string', 'max:100'],
            'customer_phone' => ['required', 'regex:/^[0-9+\-\s]{8,20}$/'],
            'quantity' => ['nullable', 'integer', 'min:1', 'max:50'],
            'options' => ['nullable', 'array'],
        ]);

        $menu = Menu::findOrFail($data['menu_id']);
        abort_unless($menu->is_available, 404);

        $groups = $menu->resolvedOptionGroups();
        $input = $request->input('options', []);
        $valid = fn ($key, $choices) => is_scalar($key) && isset($choices[$key]);

        $selections = [];
        $errors = [];
        $hasQuantityGroup = false;
        $multiplyCount = 0;

        foreach ($groups as $g => $group) {
            $picked = [];

            if ($group['type'] === 'quantity') {
                $hasQuantityGroup = true;

                foreach ((array) ($input[$g] ?? []) as $c => $qty) {
                    $qty = (int) $qty;
                    if ($qty > 0 && $valid($c, $group['choices'])) {
                        $picked[] = [$group['choices'][$c], min($qty, 99)];
                    }
                }
            } elseif ($group['type'] === 'multiple') {
                foreach ((array) ($input[$g] ?? []) as $c) {
                    if ($valid($c, $group['choices'])) {
                        $picked[] = [$group['choices'][$c], 1];
                    }
                }
            } else {
                $c = $input[$g] ?? null;
                if ($valid($c, $group['choices'])) {
                    $picked[] = [$group['choices'][$c], 1];
                }
            }

            if ($group['type'] === 'quantity' && ! empty($group['multiply'])) {
                $multiplyCount += collect($picked)->sum(fn ($p) => $p[1]);
            }

            if ($group['required'] && empty($picked)) {
                $errors["options.$g"] = 'Pilih dulu: ' . $group['name'];
            }

            foreach ($picked as [$choice, $qty]) {
                $selections[] = [
                    'group' => $group['name'],
                    'name' => $choice['name'],
                    'quantity' => $qty,
                    'price' => $choice['price'],
                ];
            }
        }

        if (! empty($errors)) {
            return back()->withInput()->withErrors($errors);
        }

        $extras = collect($selections)->sum(fn ($s) => $s['price'] * $s['quantity']);

        if ($multiplyCount > 0) {
            $quantity = $multiplyCount;
            $total = (int) $menu->price * $multiplyCount + $extras;
        } else {
            $quantity = $hasQuantityGroup ? 1 : max(1, (int) ($data['quantity'] ?? 1));
            $total = ((int) $menu->price + $extras) * $quantity;
        }

        if ($total <= 0) {
            return back()->withInput()->withErrors(['options' => 'Pilih minimal satu isi dulu ya.']);
        }

        $order = DB::transaction(function () use ($data, $menu, $selections, $quantity, $total) {
            $order = Order::create([
                'customer_name' => $data['customer_name'],
                'customer_phone' => $data['customer_phone'],
                'total_price' => $total,
            ]);

            $order->items()->create([
                'menu_id' => $menu->id,
                'menu_name' => $menu->name,
                'price' => $menu->price,
                'quantity' => $quantity,
                'subtotal' => $total,
                'selections' => $selections,
            ]);

            return $order;
        });

        $grouped = collect($selections)
            ->groupBy('group')
            ->map(fn ($items, $group) => $group . ': ' . $items
                ->map(fn ($s) => $s['name'] . ($s['quantity'] > 1 ? ' x' . $s['quantity'] : ''))
                ->implode(', '))
            ->values()
            ->all();

        $lines = [
            'Halo, saya ingin konfirmasi pesanan:',
            '',
            "No. pesanan: #{$order->id}",
            "Nama: {$order->customer_name}",
            "Menu: {$menu->name}",
        ];

        foreach ($grouped as $line) {
            $lines[] = $line;
        }

        if (! $hasQuantityGroup) {
            $lines[] = "Jumlah: {$quantity}";
        }

        $lines[] = 'Total: Rp ' . number_format($total, 0, ',', '.');
        $lines[] = '';
        $lines[] = 'Mohon info cara pembayarannya. Terima kasih!';

        $teks = rawurlencode(implode("\n", $lines));
        $nomor = config('seblak.usaha.whatsapp');

        $isMobile = preg_match('/android|iphone|ipad|ipod|mobile/i', $request->userAgent() ?? '');

        $url = $isMobile
            ? 'https://wa.me/' . $nomor . '?text=' . $teks
            : 'https://web.whatsapp.com/send?phone=' . $nomor . '&text=' . $teks;

        return redirect()->away($url);
    }
}